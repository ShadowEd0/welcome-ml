# Copier ce fichier en « .env » (ou « .env.local ») et renseigner les valeurs.
# Seules les variables préfixées par VITE_ sont exposées au bundle client.

# Measurement ID Google Analytics 4 (Admin > Flux de données > Web > ID de mesure).
# Laisser vide pour désactiver complètement Google Analytics sur le site.
VITE_GA_MEASUREMENT_ID=
